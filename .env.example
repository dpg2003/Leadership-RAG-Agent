# Copy this file to .env and fill in the values. Never commit .env.

# Required for chat, eval, the UI, and collection.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Collection only (web search adapter). Get a key at https://app.tavily.com
TAVILY_API_KEY=

# Collection only (SEC EDGAR adapter). SEC requires your name and a contact email,
# e.g. "Jane Doe jane.doe@example.com". See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=

# Optional. Leave blank to use the default (claude-sonnet-5-5).
LLM_MODEL=
