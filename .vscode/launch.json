{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch UI",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "src/leadership/ui/app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Chat CLI",
      "type": "debugpy",
      "request": "launch",
      "module": "leadership.cli",
      "args": [
        "chat",
        "${input:company}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Collect robinhood.com",
      "type": "debugpy",
      "request": "launch",
      "module": "leadership.cli",
      "args": [
        "collect",
        "robinhood.com"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Collect meetcampfire.com",
      "type": "debugpy",
      "request": "launch",
      "module": "leadership.cli",
      "args": [
        "collect",
        "meetcampfire.com"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Eval",
      "type": "debugpy",
      "request": "launch",
      "module": "leadership.cli",
      "args": [
        "eval"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "company",
      "type": "pickString",
      "description": "Company to chat about",
      "options": [
        "robinhood.com",
        "meetcampfire.com"
      ],
      "default": "robinhood.com"
    }
  ]
}
